<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jwcarman.loch</groupId>
    <artifactId>loch-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>loch-bom</artifactId>
  <packaging>pom</packaging>
  <name>Loch :: BOM</name>
  <description>Bill of Materials for Loch — version alignment for consumers</description>

  <dependencyManagement>
    <dependencies>
      <!-- Every artifact an application depends on directly. The example is not here: it is a
           demonstration rather than something to build against. Nothing a consumer chooses for
           itself belongs here either. Which serialisation, which compression and which encryption
           are the application's decisions, so pinning a codec here would be this library quietly
           taking one of them back. -->
      <dependency>
        <groupId>org.jwcarman.loch</groupId>
        <artifactId>loch-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.jwcarman.loch</groupId>
        <artifactId>loch-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.jwcarman.loch</groupId>
        <artifactId>loch-jdbc</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.jwcarman.loch</groupId>
        <artifactId>loch-spring-boot-autoconfigure</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.jwcarman.loch</groupId>
        <artifactId>loch-spring-boot-starter</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
