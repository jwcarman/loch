<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jwcarman.loch</groupId>
    <artifactId>loch-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>loch-jdbc</artifactId>
  <name>Loch :: JDBC</name>
  <description>Durable storage: encrypted payloads, lineage, and erasure by reachability.</description>

  <dependencies>
    <dependency>
      <groupId>org.jwcarman.loch</groupId>
      <artifactId>loch-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.jwcarman.codec</groupId>
      <artifactId>codec-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jwcarman.codec</groupId>
      <artifactId>codec-crypto</artifactId>
    </dependency>
    <!-- Jackson is the blessed serialisation and gzip the blessed compression, but neither is
         forced: codecs(...) takes any CodecFactory and compressedWith(...) any Codec<byte[]>. -->
    <dependency>
      <groupId>org.jwcarman.codec</groupId>
      <artifactId>codec-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jwcarman.codec</groupId>
      <artifactId>codec-transforms</artifactId>
    </dependency>
    <!-- Optional on purpose: zstd is better than gzip on both speed and ratio, but it arrives
         through zstd-jni, and a native library is not something to inflict on every consumer.
         Applications that want it add codec-zstd themselves and call zstd(). -->
    <dependency>
      <groupId>org.jwcarman.codec</groupId>
      <artifactId>codec-zstd</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
